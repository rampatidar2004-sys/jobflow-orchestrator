{
  "title": "JobFlow Orchestrator Overview",
  "uid": "jobflow-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP request rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"jobflow-backend\"}[5m])) by (uri, status)",
          "legendFormat": "{{uri}} [{{status}}]"
        }
      ]
    },
    {
      "id": 2,
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"jobflow-backend\", area=\"heap\"}) by (id)",
          "legendFormat": "{{id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Process CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"jobflow-backend\"}",
          "legendFormat": "cpu"
        }
      ]
    },
    {
      "id": 4,
      "title": "Live threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=\"jobflow-backend\"}",
          "legendFormat": "threads"
        }
      ]
    }
  ]
}
